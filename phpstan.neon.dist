includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    # Tests use Pest's dynamic expectation API, which PHPStan cannot follow; they are exercised by `composer test`.
    paths:
        - src
    scanFiles:
        - src/stubs/DefaultMetaTags.php.stub
    ignoreErrors:
        # Package config is merged into the app config, so env() is resolved and cached with it.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: src/config/config.php
